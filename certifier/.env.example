# --- Solana
CLUSTER=devnet                       # devnet | mainnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=HPomwh2M3sMcD9LpTALifnT41RQYx3rq7sUn3HrvukpR
CERTIFIER_KEYPAIR=keys/certifier.json   # must match `certifier` in the on-chain config

# --- Service
POLL_SECONDS=30
ZCASH_DELAY_SECONDS=900              # Zcash anchor follows ~15 minutes after launch
CERT_STORE=certificates.json         # public proof file (also served over HTTP)
PORT=8787

# --- HyperEVM (calldata anchor; fully public)
ENABLE_HYPEREVM=true
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_CHAIN_ID=999
HYPEREVM_PRIVATE_KEY=0x...           # small HYPE balance for gas

# --- Monero (integrated-address payment ID + tx proof), via monero-wallet-rpc
ENABLE_MONERO=true
MONERO_WALLET_RPC_URL=http://127.0.0.1:18082/json_rpc
MONERO_AMOUNT_PICONERO=1000000       # self-send amount (only the fee is spent)
MONERO_PUBLIC_ADDRESS=               # shown on the website for verification
MONERO_PUBLIC_VIEW_KEY=              # optional: lets anyone see payment IDs for this wallet

# --- Zcash (shielded memo), zcashd/Zallet-compatible RPC
ENABLE_ZCASH=true
ZCASH_RPC_URL=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
ZCASH_FROM_ADDRESS=                  # a shielded (Sapling/Orchard/unified) address you control
ZCASH_TO_ADDRESS=                    # defaults to FROM (self-send)
ZCASH_AMOUNT_ZEC=0.00001
ZCASH_PRIVACY_POLICY=FullPrivacy
ZCASH_VIEWING_KEY=                   # publish so anyone can read the memos

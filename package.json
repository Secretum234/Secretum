{
  "name": "secretum",
  "version": "1.0.0",
  "description": "Secretum: fair-launch Solana launchpad with cross-chain launch certificates",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "build": "cd programs/launchpad && cargo-build-sbf",
    "sandbox": "npm run sync-app && node devtools/sandbox.js",
    "build:devnet": "cd programs/launchpad && cargo-build-sbf --features devnet",
    "sync-app": "node -e \"require('fs').copyFileSync('client/secretum.js','app/lib/secretum.js')\"",
    "pretest": "npm run sync-app",
    "admin": "node devtools/admin.js",
    "certifier": "node certifier/index.js",
    "program-id": "node devtools/program-id.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "ethers": "^6.17.0",
    "litesvm": "^1.6.1"
  },
  "devDependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "puppeteer-core": "^23.11.1"
  }
}
